+/*** What kind of shop is here?
+ * The canonical type name, independent of the shop's display name: a vault may
+ * give a shop an arbitrary name ("Overcharged Wands"), which makes the type
+ * unrecoverable from shop_name() alone.
+ * @tparam int x
+ * @tparam int y
+ * @treturn string|nil the shop type, or nil if there is no shop at (x, y)
+ * @function shop_type_at
+ */
+static int dgn_shop_type_at(lua_State *ls)
+{
+    COORDS(s, 1, 2);
+    shop_struct *shop = shop_at(s);
+    if (!shop)
+        return 0;
+
+    PLUARET(string, shop_type_name(shop->type).c_str());
+}
