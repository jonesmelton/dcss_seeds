# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Browse and compare DCSS seed catalogs"
description:
  "Reads the s-expression records emitted by scripts/seed_dump_sexp.lua into the SQLite schema in schema.sql, flattening monster inventories so set-containment queries over a seed corpus are indexed lookups, and serves a read-only web interface over the result."
maintainer: ["Jones Melton <github@jonesmelton.com>"]
authors: ["Jones Melton"]
license: "MIT"
homepage: "https://github.com/jonesmelton/dcss_seeds"
bug-reports: "https://github.com/jonesmelton/dcss_seeds/issues"
depends: [
  "dune" {>= "3.17"}
  "ocaml" {>= "5.5.0"}
  "core"
  "core_unix"
  "digestif"
  "ppx_jane"
  "parsexp"
  "sexplib"
  "sqlite3"
  "sqlite3_utils"
  "dream" {= "1.0.0~alpha8"}
  "tyxml" {= "4.6.0"}
  "tyxml-htmx" {= version}
  "lwt" {>= "5.7.0"}
  "lwt_ppx"
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/jonesmelton/dcss_seeds.git"
